# Public (safe to expose in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Razorpay public key id (used by the checkout widget)
RAZORPAY_KEY_ID=

# Server-only secrets — never expose these to the browser
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_SECRET=
SUPABASE_SERVICE_ROLE_KEY=


SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD= # Exact name of the pickup location configured in Shiprocket (Settings → Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION=

# Token you set in Shiprocket → Settings → API → Webhooks (sent as x-api-key)
SHIPROCKET_WEBHOOK_TOKEN=
